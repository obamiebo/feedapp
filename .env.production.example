APP_HOST_PORT=18081

POSTGRES_USER=feedback
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=feedback_hub

NEXT_PUBLIC_APP_NAME="Customer Feedback & Resolution Hub"

# Browser-facing app origin used for trusted-entry redirects. Include the port for direct EC2 beta testing.
# PUBLIC_APP_URL=http://<ec2-host>:18081

# Set to false only for internal beta over plain HTTP. Use true when HTTPS is configured.
SESSION_COOKIE_SECURE=false

# Optional trusted dashboard entry. Tokens must be generated server-side by the external product dashboard.
# EXTERNAL_ENTRY_ISSUER=fihankra-dashboard
# EXTERNAL_ENTRY_SECRET=replace-with-a-long-random-entry-secret
# EXTERNAL_ENTRY_ALLOWED_SOURCES=fihankra-feedback
# EXTERNAL_ENTRY_TOKEN_TTL_SECONDS=300

SEED_ADMIN_EMAIL=obamiebo@itconsortiumgh.com
SEED_ADMIN_NAME="Obamiebo Admin"
SEED_ADMIN_TEMP_PASSWORD=replace-with-a-temporary-admin-password

# Messaging defaults for internal beta. Keep stub unless live delivery is intentionally enabled.
EMAIL_PROVIDER=stub
SMS_PROVIDER=stub

# Optional live email provider configuration.
# EMAIL_PROVIDER=itc
# EMAIL_ITC_ENDPOINT=https://apis.itcsrvc.com/messaging/send-message

# Optional live SMS provider configuration.
# SMS_PROVIDER=tfsg
# SMS_TFSG_ENDPOINT=http://52.89.222.13/tfsg/public/api/send
# SMS_TFSG_API_KEY=replace-me
# SMS_TFSG_MERCHANT_ID=1
